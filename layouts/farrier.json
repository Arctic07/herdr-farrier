{
  "id": "root",
  "type": "row",
  "theme": "farrier-charcoal",
  "ui_font": "HarmonyOS Sans SC",
  "preview": "layouts/farrier.svg",
  "background": "canvas",
  "divider": { "width": 1, "color": "border" },
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 268 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "divider": { "width": 1, "color": "border" },
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": { "mod": "workspace-chrome" },
          "size": { "px": 46 },
          "window_drag": true
        },
        {
          "id": "spaces",
          "type": "block",
          "content": { "mod": "spaces" },
          "size": { "weight": 1 },
          "min": 90
        },
        {
          "id": "agents",
          "type": "block",
          "content": { "mod": "agents" },
          "size": { "weight": 1 },
          "min": 90
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": { "mod": "workspace-chrome", "props": { "footer": true } },
          "size": { "px": 46 }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": { "mod": "tabs" },
          "size": { "px": 42 },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": [8, 8],
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 8,
                  "background": "background",
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "accent" },
                  "lone": true,
                  "header": {
                    "content": { "mod": "pane" },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": { "px": 368 },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "changes",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": { "mod": "files" }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": { "mod": "farrier-git" }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "content": { "mod": "farrier" },
          "size": { "px": 28 }
        }
      ]
    }
  ]
}
